# Render PostgreSQL Database URL
# Format: postgresql://user:password@host:port/database?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/voom_db?sslmode=require

# Supabase connection (server-side — do NOT use VITE_ prefix for secrets)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# Client-side Supabase (safe to expose — anon key only, protected by RLS)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server port (optional, defaults to 3001 in dev, 3000 in production)
PORT=3001

# Dashboard API key (REQUIRED in production, optional in dev)
# Set this to require authentication for all /api/* endpoints
DASHBOARD_API_KEY=

# Allowed CORS origins (comma-separated, optional)
# Leave empty to allow all in dev, block all in production
ALLOWED_ORIGINS=

# Node environment
NODE_ENV=development

# ── WhatsApp Business API (Meta Cloud API) ──────────────────
# Get these from: https://developers.facebook.com/apps/
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_WEBHOOK_TOKEN=voom_webhook_secret_change_me
WA_BUSINESS_ACCOUNT_ID=

# ── Group Discovery APIs (optional — mock data used if absent) ──
SERP_API_KEY=
APIFY_API_KEY=
